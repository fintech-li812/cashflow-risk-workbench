    {
      "name": "save_param_template",
      "inputSchema": {
        "required": [
          "request_id",
          "source_ref",
          "occurred_at",
          "industry_key",
          "template_version",
          "params"
        ],
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "request_id": {
            "maxLength": 128,
            "description": "稳定业务幂等键",
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "maxLength": 128,
            "description": "来源记录引用",
            "type": "string",
            "minLength": 1
          },
          "occurred_at": {
            "description": "RFC3339，必须带时区",
            "format": "date-time",
            "type": "string"
          },
          "industry_key": {
            "maxLength": 128,
            "description": "行业编码",
            "type": "string",
            "minLength": 1
          },
          "template_version": {
            "maxLength": 128,
            "description": "不可覆盖版本（修复验收报告第3处：缺 template_version 违规；v8 §8.4 旧写法 source 已作废，不接收）",
            "type": "string",
            "minLength": 1
          },
          "params": {
            "description": "R-07：不再允许空对象。必备 7 键按协议 5.4 静态约束；黄灯系数大于红灯系数的跨字段比较无法用 JSON Schema 表达，仍由服务端校验（无静态保证），服务端另须校验红灯系数非负与审批比例结构",
            "type": "object",
            "required": [
              "schema_version",
              "base_metric",
              "yellow_coefficient",
              "red_coefficient",
              "approval_ratios",
              "provenance",
              "effective_from"
            ],
            "additionalProperties": true,
            "properties": {
              "schema_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "base_metric": {
                "description": "协议 §5.4 固定为 monthly_operating_outflow",
                "type": "string",
                "const": "monthly_operating_outflow"
              },
              "yellow_coefficient": {
                "description": "有限十进制字符串；须大于 red_coefficient（服务端校验）",
                "type": "string",
                "pattern": "^[0-9]{1,10}(\\.[0-9]{1,4})?$"
              },
              "red_coefficient": {
                "description": "有限十进制字符串；非负（服务端校验）",
                "type": "string",
                "pattern": "^[0-9]{1,10}(\\.[0-9]{1,4})?$"
              },
              "approval_ratios": {
                "type": "object",
                "additionalProperties": true
              },
              "provenance": {
                "description": "区分经验建议 / 企业批准 / 已核验外部来源；外部出处未经核验不得标 verified",
                "type": "object",
                "additionalProperties": true
              },
              "effective_from": {
                "description": "RFC3339，必须带时区",
                "format": "date-time",
                "type": "string"
              }
            }
          }
        }
      },
      "description": "保存相对指标行业模板草稿，不发布或覆盖历史版本；params 必备 7 键（R-07），黄>红与红灯非负由服务端校验。",
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "destructiveHint": false
      }
    },
