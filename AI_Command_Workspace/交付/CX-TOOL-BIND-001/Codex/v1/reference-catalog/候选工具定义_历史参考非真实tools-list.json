{
  "version": "1.1",
  "date": "2026-10-22",
  "basis": [
    "docs/规格裁决_20261021.md A1/A2.1/A2.2/A5",
    "docs/规格裁决_20261022.md D8/D10/D11/D12/D13",
    "docs/外包交付/验收报告_任务一二三_v2.0.0.md 第三节（5处签名违规修复）"
  ],
  "notes": "候选文件，未经 Codex 验收不得作为 tools/list 权威输出。14 个工具名称集合与裁决 A1/D11 精确一致；event_type 24 值；risk_level 四值 green/yellow/red/unknown；risk_warning 与 risk_assessment 条件必填 rule_id+rule_version+risk_level；全部工具 additionalProperties:false。",
  "tools": [
    {
      "name": "log_to_mysql",
      "inputSchema": {
        "required": [
          "request_id",
          "source_ref",
          "occurred_at",
          "event_type",
          "payload"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "event_type"
              ],
              "properties": {
                "event_type": {
                  "const": "risk_warning"
                }
              }
            },
            "then": {
              "required": [
                "rule_id",
                "rule_version",
                "risk_level"
              ]
            }
          },
          {
            "if": {
              "required": [
                "event_type"
              ],
              "properties": {
                "event_type": {
                  "const": "risk_assessment"
                }
              }
            },
            "then": {
              "required": [
                "rule_id",
                "rule_version",
                "risk_level"
              ]
            }
          }
        ],
        "type": "object",
        "properties": {
          "request_id": {
            "maxLength": 128,
            "description": "稳定业务幂等键，重试保持不变",
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "maxLength": 128,
            "description": "来源记录引用",
            "type": "string",
            "minLength": 1
          },
          "occurred_at": {
            "description": "RFC3339，必须带时区",
            "format": "date-time",
            "type": "string"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "daily_check",
              "quality_check",
              "deada_score",
              "rf_predict",
              "risk_assessment",
              "approval",
              "exception",
              "config_change",
              "assumption_analysis",
              "industry_compare",
              "param_adjust",
              "feedback",
              "onboarding",
              "root_cause",
              "dynamic_threshold",
              "stress_test",
              "exception_review",
              "audit_triggered",
              "payment_verified",
              "da_coefficients_updated",
              "risk_warning",
              "tracking_changed",
              "parameter_changed",
              "task_result"
            ]
          },
          "rule_id": {
            "maxLength": 128,
            "description": "规则ID",
            "type": "string",
            "minLength": 1
          },
          "rule_version": {
            "maxLength": 128,
            "description": "规则版本",
            "type": "string",
            "minLength": 1
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "green",
              "yellow",
              "red",
              "unknown"
            ]
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "description": "追加千问已生成的审计结果，不执行风险计算；risk_warning/risk_assessment 必须提供规则、版本和风险等级。",
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "destructiveHint": false
      }
    },
