          "source_ref",
          "occurred_at",
          "run_id",
          "scenario",
          "scenario_version",
          "input_snapshot",
          "result_snapshot",
          "risk_level"
        ],
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "request_id": {
            "maxLength": 128,
            "description": "稳定业务幂等键",
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "maxLength": 128,
            "description": "来源记录引用",
            "type": "string",
            "minLength": 1
          },
          "occurred_at": {
            "description": "RFC3339，必须带时区",
