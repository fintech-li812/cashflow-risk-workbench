    {
      "name": "log_feedback",
      "inputSchema": {
        "required": [
          "request_id",
          "source_ref",
          "occurred_at",
          "metric_code",
          "actual_source_ref",
          "evaluation_version",
          "currency",
          "accuracy_label",
          "forecast_start_at",
          "forecast_end_at"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "audit_id"
            ]
          },
          {
            "required": [
              "forecast_id"
            ]
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "accuracy_label": {
                  "enum": [
                    "accurate",
                    "inaccurate"
                  ]
                }
              },
              "required": [
                "accuracy_label"
              ]
            },
            "then": {
              "required": [
                "predicted_value",
                "actual_value"
              ]
            }
          }
        ],
        "type": "object",
        "properties": {
          "request_id": {
            "maxLength": 128,
            "description": "稳定业务幂等键",
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "maxLength": 128,
            "description": "来源记录引用",
            "type": "string",
            "minLength": 1
          },
          "occurred_at": {
            "description": "RFC3339，必须带时区",
            "format": "date-time",
            "type": "string"
          },
          "metric_code": {
            "maxLength": 128,
            "description": "指标编码",
            "type": "string",
            "minLength": 1
          },
          "actual_source_ref": {
            "maxLength": 128,
            "description": "实际数据来源引用",
            "type": "string",
            "minLength": 1
          },
          "evaluation_version": {
            "maxLength": 128,
            "description": "评估口径版本",
            "type": "string",
            "minLength": 1
          },
          "predicted_value": {
            "description": "金额，单位元；Decimal解析。R-01：不再无条件必填——accurate/inaccurate 必须有，pending 可省略或显式 null（写库为 NULL，禁止用 0 代填）",
            "pattern": "^-?[0-9]{1,18}(\\.[0-9]{1,2})?$",
            "type": [
              "string",
              "null"
            ]
          },
          "actual_value": {
            "description": "金额，单位元；Decimal解析。R-01：不再无条件必填——实际值尚未产生时省略或显式 null，写库为 NULL；accurate/inaccurate 必须有真实实际值",
            "pattern": "^-?[0-9]{1,18}(\\.[0-9]{1,2})?$",
            "type": [
              "string",
              "null"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "CNY"
            ]
          },
          "accuracy_label": {
            "type": "string",
            "enum": [
              "accurate",
              "inaccurate",
              "pending"
            ]
          },
          "forecast_start_at": {
            "description": "RFC3339，必须带时区",
            "format": "date-time",
            "type": "string"
          },
          "forecast_end_at": {
            "description": "RFC3339，必须带时区",
            "format": "date-time",
            "type": "string"
          },
          "audit_id": {
            "maxLength": 20,
            "description": "关联 audit_log.id：DB 自增 BIGINT UNSIGNED，接口以十进制数字字符串传输（R-02）。不接受 A-demo-001 等业务串；服务端另须校验 BIGINT UNSIGNED 范围与真实同租户关联，pattern 只约束形态不保证范围",
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9]{1,20}$"
          },
          "forecast_id": {
            "maxLength": 128,
            "description": "预测体ID；与 audit_id 至少一个",
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "保存金额预测反馈；audit_id或forecast_id至少一个，单位与观察期必须一致。accuracy_label 三值枚举（修复验收报告第5处：accuracy/deviation 字段集违规）。R-01：predicted_value/actual_value 改为条件必填——accurate/inaccurate 必填（须有真实实际值），pending 可省略/null，禁止 0 代填。R-02：audit_id 为十进制数字字符串，对应 audit_log.id。",
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "destructiveHint": false
      }
    },
